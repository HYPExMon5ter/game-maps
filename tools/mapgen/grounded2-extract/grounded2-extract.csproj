<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reads Grounded 2's packaged files (UE 5.7, IoStore, Oodle) for tools/mapgen/grounded2.py. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Grounded2Extract</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202611" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202611" />
  </ItemGroup>

</Project>

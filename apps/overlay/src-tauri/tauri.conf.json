{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Maps",
  "version": "0.5.0",
  "identifier": "com.gamemaps.overlay",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cargo build --release -p game-maps-agent && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Game Maps",
        "width": 1280,
        "height": 800,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "launcher",
        "title": "Game Maps",
        "url": "launcher.html",
        "width": 500,
        "height": 560,
        "minWidth": 420,
        "minHeight": 360,
        "center": true,
        "visible": false,
        "backgroundColor": "#0e1216"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Game Maps",
    "shortDescription": "In-game maps with live location",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../../../games/sons-of-the-forest/game.json": "games/sons-of-the-forest/game.json",
      "../../../games/sunkenland/game.json": "games/sunkenland/game.json",
      "../../../games/valheim/game.json": "games/valheim/game.json",
      "../../../games/stranded-deep/game.json": "games/stranded-deep/game.json",
      "../../../games/grounded-2/game.json": "games/grounded-2/game.json",
      "../../../target/release/game_maps_agent.dll": "agent/game_maps_agent.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCRTEyQzYxRUQ2Q0JENTQKUldSVXZXenRZU3poR3hKRy91c3VFRGlxUGhTL3d4bHEzcFI1TkJrMm1NQ2ZaQjJvZURYRCtZSVEK",
      "endpoints": ["https://github.com/HYPExMon5ter/game-maps/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
